{
  "name": "formax-desktop-electron",
  "private": true,
  "version": "0.0.1",
  "description": "Electron desktop shell for Formax web runtime",
  "main": "dist/main.js",
  "scripts": {
    "build:main": "tsc -p tsconfig.json",
    "build:runtime": "node ./scripts/build-runtime.mjs",
    "electron:start": "electron .",
    "electron:start:debug": "electron --inspect=9229 .",
    "dev": "npm run build:main && node ./scripts/run.mjs --mode dev",
    "debug": "npm run build:main && node ./scripts/run.mjs --mode debug",
    "preview": "npm run build:main && node ./scripts/run.mjs --mode preview",
    "build:unpacked": "npm run build:main && npm run build:runtime && electron-builder --dir",
    "build:mac": "npm run build:main && npm run build:runtime && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg zip --publish never",
    "build:mac:arm64": "npm run build:main && npm run build:runtime && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg zip --arm64 --publish never",
    "build": "npm run build:unpacked"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "dotenv": "^17.2.3",
    "ink": "^6.6.0",
    "node-pty": "^1.0.0",
    "openai": "^6.15.0",
    "react": "^19.0.0",
    "ws": "^8.18.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "electron": "^30.5.1",
    "electron-builder": "^24.13.3",
    "typescript": "^5.9.2"
  },
  "build": {
    "appId": "com.yusifeng.formax.desktop",
    "productName": "Formax Desktop",
    "icon": "build/icon.png",
    "mac": {
      "icon": "build/icon.icns"
    },
    "directories": {
      "output": "out",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "runtime",
        "to": "runtime",
        "filter": [
          "**/*"
        ]
      }
    ],
    "npmRebuild": false,
    "asarUnpack": [
      "**/node_modules/node-pty/prebuilds/**"
    ],
    "asar": true
  }
}
