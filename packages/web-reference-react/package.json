{
  "name": "formax-web-reference-react",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:external": "PLAYWRIGHT_SKIP_WEBSERVER=1 playwright test",
    "test:e2e:headed": "playwright test --headed --project=chromium",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install chromium",
    "evidence:before": "node scripts/capture-evidence.mjs --phase=before",
    "evidence:after": "node scripts/capture-evidence.mjs",
    "test:e2e:queue:guard": "playwright test e2e/rpc-queue-dev-tools.spec.js --project=chromium",
    "test:perf:gate": "playwright test e2e/transcript-performance-gate.spec.js --project=chromium",
    "test:perf:gate:external": "PLAYWRIGHT_SKIP_WEBSERVER=1 playwright test e2e/transcript-performance-gate.spec.js --project=chromium",
    "perf:bundle:report": "node scripts/report-bundle.mjs",
    "perf:bundle:baseline:write": "node scripts/report-bundle.mjs --write-baseline",
    "perf:bundle:baseline:compare": "node scripts/report-bundle.mjs --compare-baseline",
    "perf:bundle:baseline:check": "node scripts/report-bundle.mjs --enforce-baseline",
    "perf:bundle:baseline:sync": "node scripts/report-bundle.mjs --verify-baseline-sync",
    "perf:bundle:baseline:check:ci": "node scripts/report-bundle.mjs --enforce-baseline --max-total-bytes-growth=1024 --max-entry-bytes-growth=1024"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "@formax/semantics": "workspace:*",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.3.1",
    "lucide-react": "^0.563.0",
    "marked": "^17.0.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-resizable-panels": "^2.1.7",
    "shiki": "^3.22.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "jsdom": "^25.0.1",
    "shadcn": "^3.8.4",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
}
