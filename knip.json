{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "include": [
    "files",
    "dependencies",
    "devDependencies"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "scripts/**/*.{mjs,ts,tsx}"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "scripts/**/*.{mjs,ts,tsx}"
      ]
    },
    "apps/web-reference-react": {
      "entry": [
        "scripts/**/*.mjs",
        "e2e/**/*.js"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "scripts/**/*.mjs",
        "e2e/**/*.js"
      ],
      "ignoreDependencies": [
        "shadcn",
        "tailwindcss",
        "tw-animate-css"
      ]
    },
    "apps/desktop-electron": {
      "entry": [
        "src/preload.ts",
        "scripts/**/*.mjs"
      ],
      "project": [
        "src/**/*.ts",
        "scripts/**/*.mjs"
      ],
      "ignoreDependencies": [
        "@anthropic-ai/sdk",
        "dotenv",
        "ink",
        "openai",
        "react",
        "ws",
        "zod"
      ]
    }
  }
}
