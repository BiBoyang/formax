{
  "name": "@yusifeng/formax",
  "version": "0.0.1-beta.5",
  "type": "module",
  "description": "Terminal-first AI assistant for software engineering tasks (Ink + React)",
  "license": "MIT",
  "files": [
    "bin/formax.js",
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx ./src/entrypoints/cli.tsx",
    "app-server:bridge": "tsx ./src/entrypoints/app-server-bridge.ts",
    "app-server:web-reference": "tsx ./src/entrypoints/app-server-web-reference.ts",
    "desktop:electron:dev": "npm --prefix apps/desktop-electron run dev",
    "desktop:electron:debug": "npm --prefix apps/desktop-electron run debug",
    "desktop:electron:preview": "npm --prefix apps/desktop-electron run preview",
    "desktop:electron:build:runtime": "npm --prefix apps/desktop-electron run build:runtime",
    "desktop:electron:build:mac": "npm --prefix apps/desktop-electron run build:mac",
    "desktop:electron:build": "npm --prefix apps/desktop-electron run build",
    "toole": "tsx ./src/entrypoints/tool-examples.tsx",
    "loade": "tsx ./src/entrypoints/loading-examples.tsx",
    "request:preview": "tsx ./scripts/repl-request-preview.ts",
    "request:align:toolsearch": "tsx ./scripts/request-toolsearch-alignment.ts",
    "request:check:cache-control": "tsx ./scripts/check-cache-control-alignment.ts",
    "perf:transcript": "tsx ./src/entrypoints/perf-transcript.tsx",
    "tools:coverage": "tsx ./scripts/tools-coverage.ts",
    "tools:parity": "tsx ./scripts/tools-parity.ts",
    "check:plan-traceability": "node ./scripts/check-plan-traceability.mjs",
    "check:pack-safety": "node ./scripts/check-pack-safety.mjs",
    "check:layer-contracts": "node ./scripts/check-layer-contracts.mjs",
    "check:layer-coverage": "node ./scripts/check-layer-coverage.mjs",
    "check:shared-types": "node ./scripts/check-shared-types.mjs",
    "check:doc-paths": "node ./scripts/check-doc-paths.mjs",
    "check:docs-artifact-placement": "node ./scripts/check-docs-artifact-placement.mjs",
    "check:golden-principles": "node ./scripts/check-golden-principles.mjs",
    "check:presenter-parity": "node ./scripts/check-duplicate-presenters-parity.mjs",
    "build": "bun build src/entrypoints/cli.tsx --outfile dist/cli.js --target=node --packages=external --minify",
    "build:web-ui": "node ./scripts/build-web-ui.mjs",
    "build:web-ui:fast": "node ./scripts/build-web-ui.mjs --skip-install",
    "prepack": "bun run build && bun run build:web-ui && bun run check:pack-safety",
    "core:boundaries": "node ./scripts/check-core-boundaries.mjs",
    "ui:boundaries": "node ./scripts/check-ui-boundaries.mjs",
    "features:boundaries": "node ./scripts/check-feature-boundaries.mjs",
    "type-check": "tsc --noEmit && node ./scripts/check-core-boundaries.mjs && node ./scripts/check-ui-boundaries.mjs && node ./scripts/check-feature-boundaries.mjs && node ./scripts/check-layer-coverage.mjs && node ./scripts/check-shared-types.mjs && node ./scripts/check-doc-paths.mjs",
    "lint:unused": "knip --config knip.json --exclude duplicates",
    "lint:duplicates": "knip --config knip.json --include duplicates",
    "test": "vitest run",
    "test:surface-smoke": "vitest run src/screens/repl/surfaceSmoke.test.tsx",
    "test:surface-screen-model": "tsx ./scripts/surface-screen-model-smoke.tsx",
    "test:surface-all": "bun run test:surface-smoke && bun run test:surface-screen-model",
    "test:repl-semantic-gate": "node ./scripts/repl-semantic-pre-review.mjs",
    "check:repl-single-writer": "node ./scripts/check-repl-single-writer.mjs",
    "check:semantic-streaming-perf": "tsx ./scripts/check-semantic-streaming-perf.ts",
    "test:watch": "vitest",
    "test:changed": "node ./scripts/test-changed.mjs",
    "test:coverage": "vitest run --coverage --testTimeout 30000",
    "test:coverage:backlog": "vitest run --coverage --testTimeout 30000 && node ./scripts/write-coverage-backlog.mjs",
    "test:coverage:watch": "vitest --coverage --testTimeout 30000",
    "test:coverage:gate": "vitest run --coverage --testTimeout 30000 && node ./scripts/check-coverage-thresholds.mjs",
    "test:sessions:cleanup:dry": "node ./scripts/cleanup-vitest-session-roots.mjs --days 7",
    "test:sessions:cleanup": "node ./scripts/cleanup-vitest-session-roots.mjs --days 7 --apply",
    "test:sessions:cleanup:legacy:dry": "node ./scripts/cleanup-legacy-test-sessions.mjs",
    "test:sessions:cleanup:legacy": "node ./scripts/cleanup-legacy-test-sessions.mjs --apply",
    "check:partial-stage": "node ./scripts/check-partial-stage.mjs",
    "release:patch": "npm version patch -m \"chore(release): %s\"",
    "release:minor": "npm version minor -m \"chore(release): %s\"",
    "release:major": "npm version major -m \"chore(release): %s\"",
    "release:prerelease": "npm version prerelease --preid=beta -m \"chore(release): %s\"",
    "release:prepatch": "npm version prepatch --preid=beta -m \"chore(release): %s\"",
    "release:preminor": "npm version preminor --preid=beta -m \"chore(release): %s\"",
    "release:premajor": "npm version premajor --preid=beta -m \"chore(release): %s\"",
    "release:beta": "node ./scripts/release-beta.mjs",
    "release:beta:prepatch": "node ./scripts/release-beta.mjs --bump prepatch",
    "release:beta:preminor": "node ./scripts/release-beta.mjs --bump preminor",
    "release:beta:premajor": "node ./scripts/release-beta.mjs --bump premajor"
  },
  "bin": {
    "formax": "bin/formax.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "dotenv": "^17.2.3",
    "ink": "^6.6.0",
    "openai": "^6.15.0",
    "react": "^19.0.0",
    "tsx": "^4.20.3",
    "ws": "^8.18.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "@types/react": "^19.1.8",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.0.18",
    "fast-check": "^4.5.3",
    "ink-testing-library": "^4.0.0",
    "knip": "^5.85.0",
    "typescript": "^5.9.2",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
