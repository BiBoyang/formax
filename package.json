{
  "name": "@yusifeng/formax",
  "version": "0.0.1-beta.5",
  "type": "module",
  "description": "Terminal-first AI assistant for software engineering tasks (Ink + React)",
  "license": "MIT",
  "files": [
    "bin/formax.js",
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx ./src/entrypoints/cli.tsx",
    "app-server:bridge": "tsx ./src/entrypoints/app-server-bridge.ts",
    "app-server:web-reference": "tsx ./src/entrypoints/app-server-web-reference.ts",
    "toole": "tsx ./src/entrypoints/tool-examples.tsx",
    "loade": "tsx ./src/entrypoints/loading-examples.tsx",
    "perf:transcript": "tsx ./src/entrypoints/perf-transcript.tsx",
    "tools:coverage": "tsx ./scripts/tools-coverage.ts",
    "tools:parity": "tsx ./scripts/tools-parity.ts",
    "build": "bun build src/entrypoints/cli.tsx --outfile dist/cli.js --target=node --packages=external --minify",
    "prepack": "bun run build",
    "core:boundaries": "node ./scripts/check-core-boundaries.mjs",
    "ui:boundaries": "node ./scripts/check-ui-boundaries.mjs",
    "type-check": "tsc --noEmit && node ./scripts/check-core-boundaries.mjs && node ./scripts/check-ui-boundaries.mjs",
    "test": "vitest run",
    "test:surface-smoke": "vitest run src/screens/repl/surfaceSmoke.test.tsx",
    "test:surface-screen-model": "tsx ./scripts/surface-screen-model-smoke.tsx",
    "test:surface-all": "bun run test:surface-smoke && bun run test:surface-screen-model",
    "test:watch": "vitest",
    "test:changed": "node ./scripts/test-changed.mjs",
    "test:coverage": "vitest run --coverage --testTimeout 30000",
    "test:coverage:watch": "vitest --coverage --testTimeout 30000",
    "test:coverage:gate": "vitest run --coverage --testTimeout 30000 && node ./scripts/check-coverage-thresholds.mjs",
    "check:partial-stage": "node ./scripts/check-partial-stage.mjs",
    "release:patch": "npm version patch -m \"chore(release): %s\"",
    "release:minor": "npm version minor -m \"chore(release): %s\"",
    "release:major": "npm version major -m \"chore(release): %s\"",
    "release:prerelease": "npm version prerelease --preid=beta -m \"chore(release): %s\"",
    "release:prepatch": "npm version prepatch --preid=beta -m \"chore(release): %s\"",
    "release:preminor": "npm version preminor --preid=beta -m \"chore(release): %s\"",
    "release:premajor": "npm version premajor --preid=beta -m \"chore(release): %s\""
  },
  "bin": {
    "formax": "bin/formax.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "dotenv": "^17.2.3",
    "ink": "^6.6.0",
    "openai": "^6.15.0",
    "react": "^19.0.0",
    "tsx": "^4.20.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.1.0",
    "@types/react": "^19.1.8",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.0.18",
    "fast-check": "^4.5.3",
    "ink-testing-library": "^4.0.0",
    "typescript": "^5.9.2",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
