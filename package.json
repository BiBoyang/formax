{
  "name": "formax",
  "version": "0.1.0",
  "type": "module",
  "description": "A minimal CLI demo using Ink and React",
  "scripts": {
    "dev": "tsx ./src/entrypoints/cli.tsx",
    "toole": "tsx ./src/entrypoints/tool-examples.tsx",
    "tools:coverage": "tsx ./scripts/tools-coverage.ts",
    "tools:parity": "tsx ./scripts/tools-parity.ts",
    "build": "bun build src/entrypoints/cli.tsx --outfile dist/cli.js --target=node",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "@inkjs/ui": "^2.0.0",
    "chalk": "^5.4.1",
    "dotenv": "^17.2.3",
    "ink": "^5.2.1",
    "jotai": "^2.16.1",
    "jotai-immer": "^0.4.1",
    "openai": "^6.15.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "@types/react": "^19.1.8",
    "@types/ws": "^8.18.1",
    "fast-check": "^4.5.3",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^4.0.16"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
